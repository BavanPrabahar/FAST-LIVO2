<launch>
    <!-- Standalone Loop Closure & Pose Graph Optimization (PGO) Node -->
    <arg name="odom_topic" default="/aft_mapped_to_init" />
    <arg name="cloud_topic" default="/cloud_registered" />
    <arg name="save_dir" default="$(env HOME)/output_map" />
    <arg name="pcd_filename" default="drift_free_global_map.pcd" />
    <arg name="keyframe_dist_thresh" default="1.0" />
    <arg name="keyframe_deg_thresh" default="15.0" />
    <arg name="sc_dist_thresh" default="0.28" />
    <arg name="icp_fitness_thresh" default="0.60" />
    <arg name="icp_rmse_thresh" default="0.18" />
    <arg name="voxel_size_map" default="0.05" />

    <node pkg="fast_livo" type="fast_livo2_loop_closure.py" name="fast_livo2_loop_closure" output="screen">
        <param name="odom_topic" value="$(arg odom_topic)" />
        <param name="cloud_topic" value="$(arg cloud_topic)" />
        <param name="save_dir" value="$(arg save_dir)" />
        <param name="pcd_filename" value="$(arg pcd_filename)" />
        <param name="keyframe_dist_thresh" value="$(arg keyframe_dist_thresh)" />
        <param name="keyframe_deg_thresh" value="$(arg keyframe_deg_thresh)" />
        <param name="sc_dist_thresh" value="$(arg sc_dist_thresh)" />
        <param name="icp_fitness_thresh" value="$(arg icp_fitness_thresh)" />
        <param name="icp_rmse_thresh" value="$(arg icp_rmse_thresh)" />
        <param name="voxel_size_map" value="$(arg voxel_size_map)" />
    </node>
</launch>
